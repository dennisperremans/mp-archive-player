{
  "manifest_version": 3,
  "name": "Motorpsycho Archive Player",
  "version": "1.1.0",
  "description": "Search and play live recordings from archive.org: Motorpsycho by default, King Gizzard and Grateful Dead in the settings. Random mode, keeps playing while you browse, with a tiny floating player on every page.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Motorpsycho Archive Player",
    "default_popup": "app.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://archive.org/*", "https://*.archive.org/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
